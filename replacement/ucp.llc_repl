#include "cache.h"
#include "ooo_cpu.h"
#include "tracker.h"
#include <algorithm>
#include <sstream>
#include <cstdlib>

extern uint64_t global_cycle_counter;

// Storage for UCP counters declared in inc/tracker.h.
long long int total_counts[LLC_SET][LLC_WAY] = {};
unsigned long long int total_misses = 0;
unsigned long long int total_writes = 0;

BLOCK ATD[NUM_CPUS][LLC_SET][LLC_WAY];  // ATD for each core.
vector<uint32_t> ways_of_cpu(NUM_CPUS); // Store the count of ways for a specific core after each partiiton. 
uint64_t miss_counter; //Maintains the misses in the LLC.
uint64_t hit_counter[NUM_CPUS][LLC_WAY];    //Stores hit for each core at each recency position
uint64_t partition_interval = 5000000;    // Interval after which paritioning algorithm is run
vector<vector<uint32_t>> PREV_WAY_OF_CPU(LLC_SET,vector<uint32_t>(NUM_CPUS,0)); // Current per-set owner counts.
uint32_t way_owner[LLC_SET][LLC_WAY]; // Separate from BLOCK::cpu (the core that filled a line).
bool fixed_partition_mode = false;
// FILE* file_name = fopen("input.txt","r");
static FILE* open_ucp_stats_file() {
    const char* path = std::getenv("UCP_STATS_FILE");
    FILE* fp = std::fopen((path && *path) ? path : "/dev/null", "w");
    return fp ? fp : std::fopen("/dev/null", "w");
}
FILE* output_Stats = open_ucp_stats_file(); // one file per job, /dev/null by default
#define SIZE_OF_SETS 64
unsigned rand_sets[SIZE_OF_SETS]; // Stores the dynamic sampled sets.
// global_cycle_counter is now extern from main.cc (only increments after warmup)


//Update the ATD after each miss or hit in it
void CACHE::UMON_update(uint32_t cpu, uint32_t set_index, uint32_t way)     
{
    for (uint32_t i = 0; i < NUM_WAY; i++)
    {   
        if (ATD[cpu][set_index][i].lru < ATD[cpu][set_index][way].lru) 
        {   
            ATD[cpu][set_index][i].lru++; //Incrementing the recency of blocks which were recent before the current access
        }
    }
    ATD[cpu][set_index][way].lru = 0; // promote to the MRU position
}

// Finds victim in ATD in case of ATD miss.
uint32_t CACHE::UMON_find_victim(uint32_t cpu, uint32_t set_index)
{
    uint32_t way = 0;

    // fill invalid line first
    for (way = 0; way < NUM_WAY; way++)
    {
        if (ATD[cpu][set_index][way].valid == false)        // First checking invalid way int given set.
        {   
            ATD[cpu][set_index][way].valid=true;            // Setting it to be true.

            DP(if (warmup_complete[cpu]) {
            cout << "[" << NAME << "] " << __func__ << " instr_id: " << instr_id << " invalid set: " << set << " way: " << way;
            cout << hex << " address: " << (full_addr>>LOG2_BLOCK_SIZE) << " victim address: " << ATD[cpu][set][way].address << " data: " << ATD[cpu][set][way].data;
            cout << dec << " lru: " << ATD[cpu][set][way].lru << endl; });

            break;
        }
    }

    // LRU victim
    if (way == NUM_WAY)         //No invalid block is present in the way. So least recent block is to be selected.
    {
        for (way = 0; way < NUM_WAY; way++)
        {
            if (ATD[cpu][set_index][way].lru == NUM_WAY - 1)    //Checking of least recent way in the set using lru values.
            {

                DP(if (warmup_complete[cpu]) {
                cout << "[" << NAME << "] " << __func__ << " instr_id: " << instr_id << " replace set: " << set << " way: " << way;
                cout << hex << " address: " << (full_addr>>LOG2_BLOCK_SIZE) << " victim address: " << block[set][way].address << " data: " << block[set][way].data;
                cout << dec << " lru: " << ATD[cpu][set][way].lru << endl; });
                break;
            }
        }
    }

    if (way == NUM_WAY)
    {
        cerr << "[" << NAME << "] " << __func__ << " no victim! set: " << set_index << endl;
        assert(0);
    }
    // cout<< "way = "<<way <<endl;
    return way;     // returning way of the victim in the set.
}

//Returns change in misses(utility) of cpu when its ways are increased by 1
uint64_t CACHE::get_utility(uint32_t cpu, uint32_t a)
{
    return hit_counter[cpu][a];
}

//Main UMON function. It checks ATD hits
void CACHE::UMON(uint32_t cpu, uint64_t full_addr, uint32_t set)
{
    int found =0;
    for(int i=0;i<SIZE_OF_SETS;i++){
        if(rand_sets[i]  == set) found =1;      //Checking if the set is in the sets selected for DSS
    }
    if(found ==0) return;
    uint32_t set_index = set;
    uint32_t way = 0;
    uint64_t block_addr = full_addr >> LOG2_BLOCK_SIZE; 
    //cout<<"cpu is "<<cpu<<" full addr is "<<full_addr<<endl;
    for (way = 0; way < NUM_WAY; way++)
    {
       
        //cout<<"Cpu is "<<cpu<<" set is "<<set_index<<" way is "<<way<<" address is "<<ATD[cpu][set_index][way].address<<endl;
        if (ATD[cpu][set_index][way].valid and ATD[cpu][set_index][way].address == block_addr)       //Checking ATD hits
        {
             if (warmup_complete[cpu])
            hit_counter[cpu][ATD[cpu][set_index][way].lru]++;
            //cout<<"hit counter is "<<hit_counter[cpu][ATD[cpu][set_index][way].lru]<<endl;
            break;
        }
    }
    if (way == NUM_WAY)    //It means the packet is not present in the code.
    {
        way = UMON_find_victim(cpu, set_index); //getting way of the victim in the set
         if (warmup_complete[cpu])
        miss_counter++;     //Incrementing miss counter
    }
    ATD[cpu][set_index][way].address = block_addr;   //Adding the block to the way .
    UMON_update(cpu, set_index, way);   //Updating its lru value
    
}

//partitions the LLC cache using utility.
void CACHE::make_partition()
{
    printf("\n================== [PARTITION PHASE START old ucp] ==================\n"); //CLEAR MARKER//
    printf("[UCP BASE DEBUG] Starting partition - checking hit counters:\n"); //DEBUG//
    for (uint32_t cpu = 0; cpu < NUM_CPUS; cpu++) {
        uint64_t total_hits = 0;
        for (uint32_t way = 0; way < LLC_WAY; way++) {
            total_hits += hit_counter[cpu][way];
        }
        printf("  CPU%u total hits: %lu\n", cpu, total_hits);
    }
    //DEBUG//

    uint32_t balance = LLC_WAY - NUM_CPUS,prev_balance; 
    prev_balance=balance;
    for (uint32_t i = 0; i < NUM_CPUS; i++)
        ways_of_cpu[i] = 1;         //Giving each core 1 way initially.
    while (balance)     // Looping till there is a way to give
    {
        printf("[UCP BASE DEBUG] Balance=%u, Current allocation: ", balance); //DEBUG//
        for (uint32_t i = 0; i < NUM_CPUS; i++) {
            printf("CPU%u=%u ", i, ways_of_cpu[i]);
        }
        printf("\n");
        //DEBUG//
        uint32_t winner = 0;        //Stores the cpu id with maximum utiliy.
        double final_max_utility = 0;   //Maximum change in misses found
        uint32_t req_ways=0;        //Ways required by the winner cpu for achieving maximum change in misses.
        for (uint32_t current_cpu = 0; current_cpu < NUM_CPUS; current_cpu++)
        {
            double max_utility = 0;     //Store current maximum change in misses of the core
            uint32_t current_utility=0; //Stores current change in misses of the core
            uint32_t current_ways=0;      //Stores ways required by a cpu to acheive maximum change change misses
            for (uint32_t i = ways_of_cpu[current_cpu]+1; i <= balance+ways_of_cpu[current_cpu]; i++)
            {
                current_utility += get_utility(current_cpu,i-1); //Stores change in misses as the ways allocated to the core increase 1.
                double real_utility = 1.0 * current_utility/(i-ways_of_cpu[current_cpu]); //Stores average change in misses per way.
                if(real_utility>max_utility)
                {
                    max_utility=real_utility;       //updating current maximaum change of misses of core
                    current_ways=i;
                }
            }
            if (max_utility > final_max_utility)        
            {
                final_max_utility = max_utility;        //updating final maximum change of misses of every core along with ways allocated to it.
                winner = current_cpu;
                req_ways=current_ways;
            }
        }

        printf("[UCP BASE DEBUG] Utilities: "); //DEBUG//
        for (uint32_t cpu = 0; cpu < NUM_CPUS; cpu++) {
            uint64_t max_util_cpu = 0;
            for (int k = ways_of_cpu[cpu]; k < LLC_WAY; k++) {
                uint64_t util_val = get_utility(cpu, k);
                if (util_val > max_util_cpu) max_util_cpu = util_val;
            }
            printf("CPU%u=%lu ", cpu, max_util_cpu);
        }
        printf("Winner=CPU%u\n", winner);
        //DEBUG//

        if(req_ways<=0) req_ways = ways_of_cpu[winner]; //Checking if there is not improvement in by allocating ways.
        balance-=req_ways-ways_of_cpu[winner];  //Updating balance
        ways_of_cpu[winner]=req_ways;   //updating ways of winner cpu
        if(prev_balance==balance) break;    //breaking the loop if no ways are allocated.
        else prev_balance = balance;        //else updating prev_balance.
    }
    ways_of_cpu[0]+=balance;        //giving the remaining ways to core 0 as no core has improvement with any additional ways.
    for (uint32_t i = 0; i < NUM_CPUS; i++)
    {
        fprintf(output_Stats,"%u ",ways_of_cpu[i]);    //Printing partition stats.
    }
    fprintf(output_Stats," %lu\n",partition_interval);    //Printing parition interval.


        //DEBUG print to verify UCP functionality wrt partitioning variation in every cycle
    static uint64_t partition_count = 0;
    partition_count++;
    
    printf("\n[UCP DEBUG] Partition #%lu completed:\n", partition_count);
    printf("[UCP DEBUG] Ways allocation: ");
    for (uint32_t i = 0; i < NUM_CPUS; i++) {
        printf("CPU%u=%u ", i, ways_of_cpu[i]);
    }
    printf("(Total: %u)\n", LLC_WAY);
    
printf("[UCP DEBUG] Current partition interval: %lu cycles\n", partition_interval);
printf("[UCP DEBUG] Global cycle counter: %lu cycles\n", global_cycle_counter);
    
    // Print utility summary
    printf("[UCP DEBUG] Hit counters summary:\n");
    for (uint32_t cpu = 0; cpu < NUM_CPUS; cpu++) {
        uint64_t total_hits = 0;
        for (uint32_t way = 0; way < LLC_WAY; way++) {
            total_hits += hit_counter[cpu][way];
        }
        printf("  CPU%u total hits: %lu\n", cpu, total_hits);
    }
    printf("\n");
    fflush(stdout);


    
}

//Initialzing block, ATD and rand_sets
void CACHE::llc_initialize_replacement()
{
    unsigned long rand_seed = 1;
    const unsigned long max_rand = 1048576;
    const uint32_t my_set = LLC_SET;
    for (int i = 0; i < SIZE_OF_SETS; i++) {
        bool duplicate;
        do {
            duplicate = false;
            rand_seed = rand_seed * 1103515245 + 12345;
            rand_sets[i] = ((unsigned)((rand_seed / 65536) % max_rand)) % my_set;
            for (int j = 0; j < i; j++) if (rand_sets[i] == rand_sets[j]) { duplicate = true; break; }
        } while (duplicate);
    }

    // A supplied vector pins LLC way ownership for response-surface experiments.
    fixed_partition_mode = false;
    const char* fixed_env = std::getenv("UCP_FIXED_ALLOCATION");
    if (fixed_env != nullptr && *fixed_env != '\0') {
        std::stringstream ss(fixed_env);
        std::string token;
        std::vector<uint32_t> allocation;
        while (std::getline(ss, token, ',')) {
            if (token.empty() || token.find_first_not_of("0123456789") != std::string::npos) {
                std::cerr << "[UCP ERROR] Invalid UCP_FIXED_ALLOCATION='" << fixed_env << "'\n"; std::exit(EXIT_FAILURE);
            }
            unsigned long val = std::strtoul(token.c_str(), nullptr, 10);
            if (val == 0 || val > LLC_WAY) {
                std::cerr << "[UCP ERROR] Each fixed allocation must be in [1, LLC_WAY]\n"; std::exit(EXIT_FAILURE);
            }
            allocation.push_back(static_cast<uint32_t>(val));
        }
        uint32_t sum = 0; for (uint32_t val : allocation) sum += val;
        if (allocation.size() != NUM_CPUS || sum != LLC_WAY) {
            std::cerr << "[UCP ERROR] UCP_FIXED_ALLOCATION must contain NUM_CPUS entries summing to LLC_WAY=" << LLC_WAY << "\n";
            std::exit(EXIT_FAILURE);
        }
        for (uint32_t cpu = 0; cpu < NUM_CPUS; ++cpu) ways_of_cpu[cpu] = allocation[cpu];
        fixed_partition_mode = true;
    } else {
        for (uint32_t cpu = 0; cpu < NUM_CPUS; ++cpu) ways_of_cpu[cpu] = LLC_WAY / NUM_CPUS;
        for (uint32_t w = 0; w < LLC_WAY % NUM_CPUS; ++w) ways_of_cpu[w]++;
    }

    for (uint32_t set = 0; set < NUM_SET; ++set) {
        uint32_t way = 0;
        for (uint32_t owner = 0; owner < NUM_CPUS; ++owner) {
            PREV_WAY_OF_CPU[set][owner] = ways_of_cpu[owner];
            for (uint32_t rank = 0; rank < ways_of_cpu[owner]; ++rank, ++way) {
                way_owner[set][way] = owner;
                block[set][way].lru = rank;
            }
        }
    }
    for (uint32_t cpu = 0; cpu < NUM_CPUS; ++cpu)
        for (uint32_t set = 0; set < LLC_SET; ++set)
            for (uint32_t way = 0; way < LLC_WAY; ++way) { ATD[cpu][set][way].lru = way; ATD[cpu][set][way].valid = false; }

    if (fixed_partition_mode) {
        std::cout << "[UCP] Fixed LLC way allocation active: ";
        for (uint32_t cpu = 0; cpu < NUM_CPUS; ++cpu) std::cout << "CPU" << cpu << "=" << ways_of_cpu[cpu] << " ";
        std::cout << "(total=" << LLC_WAY << ")\n";
    }
}

// find replacement victim
uint32_t CACHE::llc_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    auto lru_owned_by = [&](uint32_t owner) -> int32_t {
        int32_t result = -1;
        for (uint32_t way = 0; way < NUM_WAY; ++way)
            if (way_owner[set][way] == owner && (result < 0 || block[set][way].lru > block[set][result].lru)) result = static_cast<int32_t>(way);
        return result;
    };
    for (uint32_t way = 0; way < NUM_WAY; ++way)
        if (!block[set][way].valid && way_owner[set][way] == cpu) return way;

    if (PREV_WAY_OF_CPU[set][cpu] >= ways_of_cpu[cpu] || fixed_partition_mode) {
        int32_t result = lru_owned_by(cpu);
        if (result >= 0) return static_cast<uint32_t>(result);
    } else {
        int32_t result = -1;
        // Prefer an invalid over-quota donor way, otherwise its least-recently-used way.
        for (uint32_t way = 0; way < NUM_WAY; ++way) {
            uint32_t owner = way_owner[set][way];
            if (!block[set][way].valid && owner != cpu && PREV_WAY_OF_CPU[set][owner] > ways_of_cpu[owner]) { result = static_cast<int32_t>(way); break; }
        }
        if (result < 0) {
            for (uint32_t way = 0; way < NUM_WAY; ++way) {
                uint32_t owner = way_owner[set][way];
                if (owner != cpu && PREV_WAY_OF_CPU[set][owner] > ways_of_cpu[owner] &&
                    (result < 0 || block[set][way].lru > block[set][result].lru)) result = static_cast<int32_t>(way);
            }
        }
        if (result < 0) result = lru_owned_by(cpu);
        if (result >= 0) {
            uint32_t way = static_cast<uint32_t>(result), old_owner = way_owner[set][way];
            if (old_owner != cpu) {
                block[set][way].lru = PREV_WAY_OF_CPU[set][cpu];
                if (PREV_WAY_OF_CPU[set][old_owner] > 0) PREV_WAY_OF_CPU[set][old_owner]--;
                PREV_WAY_OF_CPU[set][cpu]++;
                way_owner[set][way] = cpu;
            }
            return way;
        }
    }
    std::cerr << "[" << NAME << " ERROR] no victim in set " << set << " for cpu " << cpu << "\n";
    std::abort();
}

void CACHE::llc_commit_way_owner(uint32_t cpu, uint32_t set, uint32_t way)
{
    uint32_t original_owner = way_owner[set][way];
    if (original_owner != cpu) {
        block[set][way].lru = PREV_WAY_OF_CPU[set][cpu];
        if (PREV_WAY_OF_CPU[set][original_owner] > 0) PREV_WAY_OF_CPU[set][original_owner]--;
        PREV_WAY_OF_CPU[set][cpu]++;
        way_owner[set][way] = cpu;
    }
}

//Updating the LLC cache
void CACHE::ucp_update(uint32_t set, uint32_t way, uint32_t cpu)
{
    const uint32_t owner = way_owner[set][way];
    for (uint32_t i = 0; i < NUM_WAY; ++i)
        if (i != way && way_owner[set][i] == owner && block[set][i].lru < block[set][way].lru) block[set][i].lru++;
    block[set][way].lru = 0;
}

void CACHE::enforce_partition_immediately()
{
    for (uint32_t set = 0; set < NUM_SET; ++set) {
        std::fill(PREV_WAY_OF_CPU[set].begin(), PREV_WAY_OF_CPU[set].end(), 0);
        for (uint32_t way = 0; way < NUM_WAY; ++way) PREV_WAY_OF_CPU[set][way_owner[set][way]]++;
        for (uint32_t receiver = 0; receiver < NUM_CPUS; ++receiver) {
            while (PREV_WAY_OF_CPU[set][receiver] < ways_of_cpu[receiver]) {
                int32_t victim = -1;
                for (uint32_t donor = 0; donor < NUM_CPUS; ++donor) {
                    if (PREV_WAY_OF_CPU[set][donor] <= ways_of_cpu[donor]) continue;
                    for (uint32_t way = 0; way < NUM_WAY; ++way)
                        if (way_owner[set][way] == donor && (victim < 0 || block[set][way].lru > block[set][victim].lru)) victim = static_cast<int32_t>(way);
                }
                if (victim < 0) { std::cerr << "[UCP ERROR] Unable to satisfy allocation in set " << set << "\n"; std::abort(); }
                uint32_t way = static_cast<uint32_t>(victim), old_owner = way_owner[set][victim];
                block[set][way].lru = PREV_WAY_OF_CPU[set][receiver];
                way_owner[set][way] = receiver;
                PREV_WAY_OF_CPU[set][old_owner]--;
                PREV_WAY_OF_CPU[set][receiver]++;
            }
        }
        for (uint32_t cpu = 0; cpu < NUM_CPUS; ++cpu)
            if (PREV_WAY_OF_CPU[set][cpu] != ways_of_cpu[cpu]) {
                std::cerr << "[UCP ERROR] Allocation mismatch in set " << set << ", CPU" << cpu << "\n"; std::abort();
            }
    }
}

// called on every cache hit and cache fill
void CACHE::llc_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
    if (type != LOAD && type != RFO && type != PREFETCH && type != WRITEBACK) assert(0);
    if (type == WRITEBACK) total_writes++;
    if (!hit) total_misses++;
    if (type == WRITEBACK && ip) assert(0);
    if (hit && type == WRITEBACK) return;

    if (!fixed_partition_mode) {
        UMON(cpu, full_addr, set);
        if (global_cycle_counter >= partition_interval) {
            make_partition();
            enforce_partition_immediately();
            partition_interval += 5000000;
            for (uint32_t c = 0; c < NUM_CPUS; ++c)
                for (uint32_t rank = 0; rank < LLC_WAY; ++rank) hit_counter[c][rank] /= 2;
            miss_counter = 0;
        }
    }
    ucp_update(set, way, way_owner[set][way]);
}

void CACHE::llc_update_replacement_state_WE(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
    total_counts[set][way]++;
    llc_update_replacement_state(cpu, set, way, full_addr, ip, victim_addr, type, hit);
}

void CACHE::llc_replacement_final_stats()
{
    fclose(output_Stats);// closing file
    //cout<<"outsi"<<one<<" "<<two<<" "<<three<<" "<<four<<" "<<five;
}


